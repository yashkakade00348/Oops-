#include <iostream>
using namespace std;

class Student
{
    int roll;
    char name[30];
    float marks;

public:

    void addStudent()
    {
        cout << "Enter Roll Number: ";
        cin >> roll;

        cout << "Enter Name: ";
        cin >> name;

        cout << "Enter Marks: ";
        cin >> marks;

        cout << "Student Added Successfully!" << endl;
    }

    void displayStudent()
    {
        cout << "\nRoll Number: " << roll;
        cout << "\nName: " << name;
        cout << "\nMarks: " << marks << endl;
    }

    int getRoll()
    {
        return roll;
    }
};

int main()
{
    Student s[50];
    int count = 0;
    int choice, r, found;

    do
    {
        cout << "\n===== STUDENT MANAGEMENT SYSTEM =====";
        cout << "\n1. Add Student";
        cout << "\n2. Display Students";
        cout << "\n3. Search Student";
        cout << "\n4. Exit";

        cout << "\nEnter your choice: ";
        cin >> choice;

        switch(choice)
        {
            case 1:
                if(count < 50)
                {
                    s[count].addStudent();
                    count++;
                }
                else
                {
                    cout << "Student limit reached!";
                }
                break;

            case 2:
                if(count == 0)
                {
                    cout << "No student records found!";
                }
                else
                {
                    for(int i = 0; i < count; i++)
                    {
                        s[i].displayStudent();
                    }
                }
                break;

            case 3:
                cout << "Enter Roll Number: ";
                cin >> r;

                found = 0;

                for(int i = 0; i < count; i++)
                {
                    if(s[i].getRoll() == r)
                    {
                        s[i].displayStudent();
                        found = 1;
                        break;
                    }
                }

                if(found == 0)
                {
                    cout << "Student Not Found!";
                }
                break;

            case 4:
                cout << "Thank You!";
                break;

            default:
                cout << "Invalid Choice!";
        }

    } while(choice != 4);

    return 0;
}
