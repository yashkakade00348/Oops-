

#include <iostream>
#include <string>
using namespace std;

int main() {
    string name;
    int age;
    double marks;
    char grade;
    const string university = "ADYPU";

    cout << "Enter name: " << endl;
    cin >> name;
    cout << "Enter age: " << endl;
    cin >> age;
    cout << "Enter marks: " << endl;
    cin >> marks;
    cout << "Enter grade: " << endl;
    cin >> grade;

    bool isPassed = (marks >= 40);

    cout << "\nStudent Details:" << endl;
    cout << "Name: " << name << endl;
    cout << "University: " << university << endl;
    cout << "Age: " << age << endl;
    cout << "Grade: " << grade << endl;
    cout << "Passed: " << (isPassed ? "Yes" : "No") << endl;

    return 0;
}
